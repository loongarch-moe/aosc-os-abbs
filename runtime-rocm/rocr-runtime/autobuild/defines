PKGNAME=rocr-runtime
PKGDES="User space library for launching compute kernels on ROCm-compatible Radeon cards"
PKGSEC=devel
PKGDEP="numactl libdrm elfutils zlib rocm-llvm rocm-rocprofiler-register zstd"
BUILDDEP="cmake"

USECLANG=1
NOLTO=1
NOSTATIC=0

ABTYPE=cmakeninja

CMAKE_AFTER="
-DCMAKE_C_COMPILER=/usr/lib/rocm/lib/llvm/bin/clang
-DCMAKE_CXX_COMPILER=/usr/lib/rocm/lib/llvm/bin/clang++
-DCMAKE_INSTALL_PREFIX=/usr/lib/rocm
-DCMAKE_PREFIX_PATH=/usr/lib/rocm
-DClang_DIR=/usr/lib/rocm/lib/llvm/lib/cmake/clang/
-DBUILD_SHARED_LIBS=ON
-DCMAKE_INSTALL_RPATH=/usr/lib/rocm/lib/llvm/lib;/usr/lib/rocm/lib
-DCMAKE_SKIP_INSTALL_RPATH=OFF
"

# FIXME: rocm-llvm does not build on MIPS.
FAIL_ARCH="!(amd64|arm64|loongarch64|ppc64el|riscv64)"
